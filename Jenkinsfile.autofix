pipeline {
  agent any

  parameters {
    string(name: 'FAILED_SHA', defaultValue: '', trim: true)
    string(name: 'BASE_BRANCH', defaultValue: 'main', trim: true)
    string(name: 'UPSTREAM_BUILD_URL', defaultValue: '', trim: true)
    string(name: 'UPSTREAM_FAILURE_KIND', defaultValue: '', trim: true)
  }

  options {
    skipDefaultCheckout(true)
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }

  environment {
    UPSTREAM_REPOSITORY_URL = 'git@github.com:Rustify-All/rlucene.git'
    FORK_REPOSITORY_URL = 'git@github.com:LuXugang/rlucene.git'
    FORK_REPOSITORY = 'LuXugang/rlucene'
    FORK_OWNER = 'LuXugang'
    JAVA_REFERENCE_REPOSITORY_URL =
      'git@github.com:LuXugang/lucene.git'
    JAVA_REFERENCE_BRANCH = 'rlucene_10_1'
    GIT_CREDENTIALS_ID = 'github-ssh'
    DEEPSEEK_CREDENTIALS_ID = 'deepseek-api-key'
    GITHUB_CREDENTIALS_ID = 'github-autofix-token'
    OPENCODE_BIN = '/var/jenkins_home/tools/opencode/bin/opencode'
    OPENCODE_STATE_DIR = '/var/jenkins_home/tools/opencode/home'
    AUTOFIX_STATE_ROOT = '/var/jenkins_home/ai-autofix-state/rlucene'
    RUSTUP_DIST_SERVER = 'https://rsproxy.cn'
    RUSTUP_UPDATE_ROOT = 'https://rsproxy.cn/rustup'
    RUSTUP_HOME = '/opt/rustup'
    CARGO_HOME = '/opt/cargo'
    CARGO_TARGET_DIR = '/var/jenkins_home/cargo-target/rlucene-autofix'
    CARGO_PROFILE_TEST_DEBUG = '0'
    CARGO_TERM_COLOR = 'never'
    RUST_BACKTRACE = 'full'
    NO_COLOR = '1'
    CARGO_NET_RETRY = '10'
    CARGO_HTTP_TIMEOUT = '120'
    CARGO_HTTP_MULTIPLEXING = 'false'
  }

  stages {
    stage('Validate request') {
      steps {
        script {
          env.SKIP_AUTOFIX = 'false'
          env.REPRODUCED = 'false'
          env.PATCH_READY = 'false'
          env.JAVA_REFERENCE_SHA = ''
          if (!(params.FAILED_SHA ==~ /[0-9a-fA-F]{40}/)) {
            error('FAILED_SHA must be exactly 40 hexadecimal characters.')
          }
          if (params.BASE_BRANCH != 'main') {
            error('Only main may be used as BASE_BRANCH.')
          }

          String normalizedSha = params.FAILED_SHA.toLowerCase()
          String shortSha = normalizedSha.take(12)
          env.FAILED_SHA_NORMALIZED = normalizedSha
          env.SHA_SHORT = shortSha
          env.FIX_BRANCH = "deepseek/jenkins-autofix-${shortSha}"
          env.ATTEMPT_MARKER =
            "${env.AUTOFIX_STATE_ROOT}/${normalizedSha}.attempted"
          currentBuild.description = shortSha
          echo 'Autofix pipeline revision: deepseek-opencode-v2-fork-pr'
        }
      }
    }

    stage('Checkout failed commit') {
      steps {
        dir('source') {
          deleteDir()
          checkout([
            $class: 'GitSCM',
            branches: [[name: '*/main']],
            userRemoteConfigs: [[
              credentialsId: env.GIT_CREDENTIALS_ID,
              url: env.UPSTREAM_REPOSITORY_URL
            ]]
          ])

          withCredentials([sshUserPrivateKey(
            credentialsId: env.GIT_CREDENTIALS_ID,
            keyFileVariable: 'GIT_SSH_KEY',
            usernameVariable: 'GIT_SSH_USER'
          )]) {
            script {
              sh '''#!/bin/bash
                set -euo pipefail
                set +x
                export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
                git remote remove fork >/dev/null 2>&1 || true
                git remote add fork "$FORK_REPOSITORY_URL"
                git fetch --no-tags --prune fork \
                  '+refs/heads/*:refs/remotes/fork/*'
                git cat-file -e "$FAILED_SHA_NORMALIZED^{commit}"
                git checkout --detach "$FAILED_SHA_NORMALIZED"
                test "$(git rev-parse HEAD)" = "$FAILED_SHA_NORMALIZED"
                test -f AGENTS.md
              '''
              int remoteBranchExists = sh(
                returnStatus: true,
                script: '''#!/bin/bash
                  set +x
                  export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
                  git ls-remote --exit-code --heads fork "refs/heads/$FIX_BRANCH" >/dev/null 2>&1
                '''
              )
              if (remoteBranchExists == 0) {
                env.SKIP_AUTOFIX = 'true'
                currentBuild.result = 'NOT_BUILT'
                currentBuild.description = "${env.SHA_SHORT}: branch exists"
                echo "Skipping: ${env.FIX_BRANCH} already exists."
              }
            }
          }
        }
      }
    }

    stage('Claim single attempt') {
      when {
        expression { env.SKIP_AUTOFIX != 'true' }
      }
      steps {
        script {
          int markerExists = sh(
            returnStatus: true,
            script: 'test -e "$ATTEMPT_MARKER"'
          )
          if (markerExists == 0) {
            env.SKIP_AUTOFIX = 'true'
            currentBuild.result = 'NOT_BUILT'
            currentBuild.description = "${env.SHA_SHORT}: already attempted"
            echo "Skipping: this commit already has an attempt marker."
          } else {
            sh '''#!/bin/bash
              set -euo pipefail
              umask 077
              mkdir -p "$AUTOFIX_STATE_ROOT"
              {
                printf 'commit=%s\n' "$FAILED_SHA_NORMALIZED"
                printf 'jenkins_build=%s\n' "$BUILD_URL"
                printf 'upstream_build=%s\n' "$UPSTREAM_BUILD_URL"
                printf 'upstream_failure_kind=%s\n' \
                  "$UPSTREAM_FAILURE_KIND"
                printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
              } > "$ATTEMPT_MARKER"
            '''
          }
        }
      }
    }

    stage('Reproduce failure') {
      when {
        expression { env.SKIP_AUTOFIX != 'true' }
      }
      steps {
        dir('source') {
          sh '''#!/bin/bash
            set -euo pipefail
            mkdir -p "$CARGO_TARGET_DIR"
            cargo fetch
          '''
          script {
            int reproduceStatus = sh(
              returnStatus: true,
              script: '''#!/bin/bash
                set -uo pipefail
                rm -f initial-test.log initial-nextest-junit.xml
                rm -f target/nextest/ci/junit.xml
                if ! cargo nextest --version > initial-test.log 2>&1; then
                  cat initial-test.log
                  exit 125
                fi
                printf '\\nNextest reproduction:\\n' >> initial-test.log
                set +e
                timeout --kill-after=30s 12m \
                  cargo nextest run --profile ci --workspace \
                  >> initial-test.log 2>&1
                nextest_status=$?
                junit_source="target/nextest/ci/junit.xml"
                if [ -f "$junit_source" ]; then
                  cp "$junit_source" initial-nextest-junit.xml
                fi
                if [ "$nextest_status" -ne 0 ]; then
                  cat initial-test.log
                  exit "$nextest_status"
                fi
                printf '\\nDoctest reproduction:\\n' >> initial-test.log
                timeout --kill-after=30s 4m \
                  cargo test --workspace --doc -q \
                  >> initial-test.log 2>&1
                test_status=$?
                cat initial-test.log
                exit "$test_status"
              '''
            )
            String reproduceLog = readFile(file: 'initial-test.log')
            String reproduceJunit =
              fileExists('initial-nextest-junit.xml') ?
                readFile(file: 'initial-nextest-junit.xml') : ''
            boolean testTimedOut = reproduceLog.contains('TIMEOUT [')
            boolean testReportedFailure =
              reproduceLog.contains('FAIL [') ||
              testTimedOut ||
              reproduceLog.contains('test result: FAILED') ||
              reproduceLog.contains('\nerror:') ||
              reproduceLog.startsWith('error:') ||
              reproduceLog.contains('\nerror[') ||
              reproduceLog.startsWith('error[') ||
              reproduceJunit.contains('<failure') ||
              reproduceJunit.contains('<error')
            sh '''
              git ls-files --error-unmatch Cargo.lock >/dev/null 2>&1 || \
                rm -f Cargo.lock
            '''

            if (reproduceStatus == 0) {
              env.SKIP_AUTOFIX = 'true'
              currentBuild.result = 'NOT_BUILT'
              currentBuild.description = "${env.SHA_SHORT}: not reproduced"
              echo 'Failure did not reproduce; DeepSeek will not modify code.'
            } else if (
              reproduceStatus == 124 ||
              reproduceStatus == 125 ||
              reproduceStatus == 137
            ) {
              env.SKIP_AUTOFIX = 'true'
              currentBuild.result = 'UNSTABLE'
              currentBuild.description =
                "${env.SHA_SHORT}: infrastructure reproduction failure"
              echo(
                "Reproduction infrastructure failed, timed out, or was " +
                "killed (exit ${reproduceStatus})."
              )
            } else if (testReportedFailure) {
              env.REPRODUCED = 'true'
              if (testTimedOut) {
                currentBuild.description =
                  "${env.SHA_SHORT}: test timeout reproduced"
              }
            } else {
              env.SKIP_AUTOFIX = 'true'
              currentBuild.result = 'UNSTABLE'
              currentBuild.description =
                "${env.SHA_SHORT}: unclassified reproduction failure"
              echo(
                'Reproduction failed without test evidence; DeepSeek will ' +
                'not modify code.'
              )
            }
          }
        }
      }
    }

    stage('Checkout Java reference') {
      when {
        expression { env.REPRODUCED == 'true' }
      }
      steps {
        dir('java-reference') {
          sh '''#!/bin/bash
            set -euo pipefail
            chmod -R u+rwX . >/dev/null 2>&1 || true
          '''
          checkout([
            $class: 'GitSCM',
            branches: [[name: "*/${env.JAVA_REFERENCE_BRANCH}"]],
            extensions: [
              [
                $class: 'CleanBeforeCheckout',
                deleteUntrackedNestedRepositories: true
              ],
              [
                $class: 'CloneOption',
                depth: 1,
                honorRefspec: true,
                noTags: true,
                reference: '',
                shallow: true,
                timeout: 10
              ]
            ],
            userRemoteConfigs: [[
              credentialsId: env.GIT_CREDENTIALS_ID,
              name: 'origin',
              refspec:
                "+refs/heads/${env.JAVA_REFERENCE_BRANCH}:" +
                "refs/remotes/origin/${env.JAVA_REFERENCE_BRANCH}",
              url: env.JAVA_REFERENCE_REPOSITORY_URL
            ]]
          ])
          script {
            String javaReferenceSha = sh(
              returnStdout: true,
              script: 'git rev-parse HEAD'
            ).trim()
            if (!javaReferenceSha) {
              error('Unable to determine the Java reference commit SHA.')
            }
            env.JAVA_REFERENCE_SHA = javaReferenceSha
            currentBuild.description =
              "${env.SHA_SHORT}: Java ${javaReferenceSha.take(12)}"
          }
          sh '''#!/bin/bash
            set -euo pipefail
            test -d lucene/core/src/java
            test -d lucene/core/src/test
            test "$(git rev-parse HEAD)" = "$JAVA_REFERENCE_SHA"
            printf 'Java reference: %s@%s (%s)\\n' \
              "$JAVA_REFERENCE_REPOSITORY_URL" \
              "$JAVA_REFERENCE_BRANCH" \
              "$JAVA_REFERENCE_SHA"
            du -sh .
            chmod -R a-w .
          '''
        }
      }
    }

    stage('Verify DeepSeek runtime') {
      when {
        expression { env.REPRODUCED == 'true' }
      }
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          if [ -n "${CODEX_HTTPS_PROXY:-}" ]; then
            export HTTP_PROXY="$CODEX_HTTPS_PROXY"
            export HTTPS_PROXY="$CODEX_HTTPS_PROXY"
            export http_proxy="$CODEX_HTTPS_PROXY"
            export https_proxy="$CODEX_HTTPS_PROXY"
          fi
          test -x "$OPENCODE_BIN"
          mkdir -p "$OPENCODE_STATE_DIR"
          "$OPENCODE_BIN" --version
          curl -sS --connect-timeout 10 --max-time 20 \
            -o /dev/null https://api.deepseek.com/v1/models
        '''
      }
    }

    stage('Generate minimal fix with DeepSeek') {
      when {
        expression { env.REPRODUCED == 'true' }
      }
      steps {
        writeFile(
          file: 'opencode-autofix.json',
          text: '''{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-autofix/deepseek-v4-pro",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "provider": {
    "deepseek-autofix": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": {
      "*": "allow",
      "__JAVA_REFERENCE_DIR__/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": {
      "*": "deny",
      "__JAVA_REFERENCE_DIR__/**": "allow"
    }
  }
}
'''.replace(
            '__JAVA_REFERENCE_DIR__',
            "${env.WORKSPACE}/java-reference"
          )
        )
        writeFile(
          file: 'autofix-task.md',
          text: """You are fixing a Rust project failure reproduced by Jenkins
using DeepSeek through OpenCode.

Failed commit: ${env.FAILED_SHA_NORMALIZED}
Upstream build: ${params.UPSTREAM_BUILD_URL}
Upstream failure kind: ${params.UPSTREAM_FAILURE_KIND}
Java reference branch: ${env.JAVA_REFERENCE_BRANCH}
Java reference commit: ${env.JAVA_REFERENCE_SHA}
Read-only Java reference: ${env.WORKSPACE}/java-reference

Before reading any other repository file, read AGENTS.md completely and follow
all applicable instructions in it. Then read initial-test.log,
initial-nextest-junit.xml when present, and the relevant Rust source. Before
changing Rust code, locate the corresponding Java implementation and Java test
under the read-only Java reference, compare the behavior and control flow, and
use that comparison to identify migration differences. The reference is
exactly LuXugang/lucene:${env.JAVA_REFERENCE_BRANCH} at
${env.JAVA_REFERENCE_SHA}; do not use another Java branch and never modify the
reference checkout. For a nextest TIMEOUT, use the exact test name, elapsed
time, captured output, and any reported random seed as the primary evidence.
Make the smallest root-cause fix. If no corresponding Java implementation or
test exists, say so explicitly and continue only from reliable Rust evidence.
Do not run Cargo, tests, repository scripts, or any compiled code during this
model invocation; Jenkins validates after the DeepSeek credential is removed.
Do not add ignored tests, remove tests, weaken assertions, modify Jenkins
automation or .config/nextest.toml, upgrade unrelated dependencies, commit,
push, or create a pull request. If the evidence indicates infrastructure or a
non-reproducible flaky failure, make no changes and explain why.
"""
        )
        dir('source') {
          withCredentials([string(
            credentialsId: env.DEEPSEEK_CREDENTIALS_ID,
            variable: 'DEEPSEEK_KEY'
          )]) {
            sh '''#!/bin/bash
              set -euo pipefail
              umask 077
              export JENKINS_AUTOFIX=1
              export DEEPSEEK_API_KEY="$DEEPSEEK_KEY"
              export JAVA_REFERENCE_DIR="$WORKSPACE/java-reference"
              export XDG_DATA_HOME="$OPENCODE_STATE_DIR/data"
              export XDG_CONFIG_HOME="$OPENCODE_STATE_DIR/config"
              export XDG_CACHE_HOME="$OPENCODE_STATE_DIR/cache"
              export OPENCODE_CONFIG_CONTENT
              OPENCODE_CONFIG_CONTENT="$(<"$WORKSPACE/opencode-autofix.json")"
              export OPENCODE_DISABLE_AUTOUPDATE=true
              export OPENCODE_AUTO_SHARE=false
              export OPENCODE_DISABLE_DEFAULT_PLUGINS=true
              export OPENCODE_DISABLE_LSP_DOWNLOAD=true
              export OPENCODE_DISABLE_CLAUDE_CODE=true
              if [ -n "${CODEX_HTTPS_PROXY:-}" ]; then
                export HTTP_PROXY="$CODEX_HTTPS_PROXY"
                export HTTPS_PROXY="$CODEX_HTTPS_PROXY"
                export http_proxy="$CODEX_HTTPS_PROXY"
                export https_proxy="$CODEX_HTTPS_PROXY"
              fi
              test -d "$JAVA_REFERENCE_DIR/lucene/core/src/java"
              test -d "$JAVA_REFERENCE_DIR/lucene/core/src/test"
              test "$(git -C "$JAVA_REFERENCE_DIR" rev-parse HEAD)" = \
                "$JAVA_REFERENCE_SHA"
              test -z "$(git -C "$JAVA_REFERENCE_DIR" status --porcelain)"
              test ! -w "$JAVA_REFERENCE_DIR/lucene/core/src/java"
              restore_java_reference_permissions() {
                chmod -R u+rwX "$JAVA_REFERENCE_DIR" >/dev/null 2>&1 || true
              }
              trap restore_java_reference_permissions EXIT
              set +x
              set +e
              "$OPENCODE_BIN" run \
                --model deepseek-autofix/deepseek-v4-pro \
                --agent build \
                --format json \
                "$(cat "$WORKSPACE/autofix-task.md")" \
                > "$WORKSPACE/deepseek-result.jsonl" 2>&1
              agent_status=$?
              set -e
              cat "$WORKSPACE/deepseek-result.jsonl"
              exit "$agent_status"
            '''
          }
        }
      }
    }

    stage('Audit patch') {
      when {
        expression { env.REPRODUCED == 'true' }
      }
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          test -d "$WORKSPACE/java-reference/.git"
          test "$(git -C "$WORKSPACE/java-reference" rev-parse HEAD)" = \
            "$JAVA_REFERENCE_SHA"
          test -z "$(git -C "$WORKSPACE/java-reference" status --porcelain)"
        '''
        dir('source') {
          script {
            int noChanges = sh(
              returnStatus: true,
              script: 'test -z "$(git status --porcelain)"'
            )
            if (noChanges == 0) {
              env.SKIP_AUTOFIX = 'true'
              currentBuild.result = 'NOT_BUILT'
              currentBuild.description = "${env.SHA_SHORT}: no patch"
              echo 'DeepSeek produced no patch.'
            } else {
              sh '''#!/bin/bash
                set -euo pipefail
                git diff --check
                if git status --porcelain | awk '{print $2}' | \
                  grep -Eq '^([.]config/nextest[.]toml|AGENTS[.]md|Jenkinsfile|Jenkinsfile[.]autofix|ci/jenkins/)'; then
                  echo 'DeepSeek attempted to modify protected automation files.' >&2
                  exit 1
                fi
                if git diff --unified=0 | grep '^+' | grep -F '#[ignore]'; then
                  echo 'DeepSeek attempted to add #[ignore].' >&2
                  exit 1
                fi
              '''
              env.PATCH_READY = 'true'
            }
          }
        }
      }
    }

    stage('Independent verification') {
      when {
        expression { env.PATCH_READY == 'true' }
      }
      steps {
        dir('source') {
          sh '''#!/bin/bash
            set -euo pipefail
            unset DEEPSEEK_API_KEY DEEPSEEK_KEY OPENCODE_CONFIG_CONTENT \
              GH_TOKEN GITHUB_TOKEN
            timeout --kill-after=30s 12m cargo tidy
            cargo fmt --all -- --check
          '''
          script {
            int verifyStatus = sh(
              returnStatus: true,
              script: '''#!/bin/bash
                set -uo pipefail
                unset DEEPSEEK_API_KEY DEEPSEEK_KEY OPENCODE_CONFIG_CONTENT \
                  GH_TOKEN GITHUB_TOKEN
                rm -f final-test.log final-nextest-junit.xml
                rm -f target/nextest/ci/junit.xml
                if ! cargo nextest --version > final-test.log 2>&1; then
                  cat final-test.log
                  exit 125
                fi
                printf '\\nNextest verification:\\n' >> final-test.log
                set +e
                timeout --kill-after=30s 20m \
                  cargo nextest run --profile ci --workspace \
                  >> final-test.log 2>&1
                nextest_status=$?
                junit_source="target/nextest/ci/junit.xml"
                if [ -f "$junit_source" ]; then
                  cp "$junit_source" final-nextest-junit.xml
                fi
                if [ "$nextest_status" -ne 0 ]; then
                  cat final-test.log
                  exit "$nextest_status"
                fi
                printf '\\nDoctest verification:\\n' >> final-test.log
                timeout --kill-after=30s 4m \
                  cargo test --workspace --doc -q \
                  >> final-test.log 2>&1
                test_status=$?
                cat final-test.log
                exit "$test_status"
              '''
            )
            String finalTestLog = readFile(file: 'final-test.log')
            String finalNextestJunit =
              fileExists('final-nextest-junit.xml') ?
                readFile(file: 'final-nextest-junit.xml') : ''
            boolean testReportedFailure =
              finalTestLog.contains('FAIL [') ||
              finalTestLog.contains('TIMEOUT [') ||
              finalTestLog.contains('test result: FAILED') ||
              finalTestLog.contains('\nerror:') ||
              finalTestLog.startsWith('error:') ||
              finalTestLog.contains('\nerror[') ||
              finalTestLog.startsWith('error[') ||
              finalNextestJunit.contains('<failure') ||
              finalNextestJunit.contains('<error')
            if (verifyStatus != 0 || testReportedFailure) {
              error(
                "Independent nextest/doctest verification failed " +
                "(exit ${verifyStatus})."
              )
            }
          }
          sh '''#!/bin/bash
            set -euo pipefail
            git ls-files --error-unmatch Cargo.lock >/dev/null 2>&1 || \
              rm -f Cargo.lock
            git diff --check
          '''
        }
      }
    }

    stage('Publish PR') {
      when {
        expression { env.PATCH_READY == 'true' }
      }
      steps {
        dir('source') {
          sh '''#!/bin/bash
            set -euo pipefail
            git config user.name 'jenkins-deepseek-autofix'
            git config user.email 'jenkins-deepseek-autofix@users.noreply.github.com'
            rm -f initial-test.log initial-nextest-junit.xml \
              final-test.log final-nextest-junit.xml pr-response.json
            git switch -c "$FIX_BRANCH"
            git add -A
            git commit -m "fix: repair Jenkins failure for $SHA_SHORT"
          '''

          script {
            writeFile(
              file: 'pr-payload.json',
              text: groovy.json.JsonOutput.toJson([
                title: "DeepSeek: fix tests for ${env.SHA_SHORT}",
                head: "${env.FORK_OWNER}:${env.FIX_BRANCH}",
                head_repo: env.FORK_REPOSITORY,
                base: 'main',
                body: """Automated Jenkins/DeepSeek repair using OpenCode.

Failed commit: `${env.FAILED_SHA_NORMALIZED}`
Upstream build: ${params.UPSTREAM_BUILD_URL}
Failure kind: `${params.UPSTREAM_FAILURE_KIND}`
Java reference: `LuXugang/lucene:${env.JAVA_REFERENCE_BRANCH}`
Java reference commit: `${env.JAVA_REFERENCE_SHA}`

Verified with `cargo tidy`, `cargo fmt --all -- --check`,
`cargo nextest run --profile ci --workspace`, and
`cargo test --workspace --doc -q`.

This is a ready-for-review PR. Human review and manual merge are required;
this PR will never be auto-merged.""",
                draft: false,
                maintainer_can_modify: true
              ])
            )
          }

          withCredentials([sshUserPrivateKey(
            credentialsId: env.GIT_CREDENTIALS_ID,
            keyFileVariable: 'GIT_SSH_KEY',
            usernameVariable: 'GIT_SSH_USER'
          )]) {
            sh '''#!/bin/bash
              set -euo pipefail
              set +x
              export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
              git push fork "HEAD:refs/heads/$FIX_BRANCH"
            '''
          }

          withCredentials([string(
            credentialsId: env.GITHUB_CREDENTIALS_ID,
            variable: 'GH_AUTOFIX_TOKEN'
          )]) {
            sh '''#!/bin/bash
              set -euo pipefail
              umask 077
              trap 'rm -f pr-payload.json' EXIT
              set +x
              HTTP_STATUS=$(curl -sS \
                -X POST \
                -H "Authorization: Bearer $GH_AUTOFIX_TOKEN" \
                -H 'Accept: application/vnd.github+json' \
                -H 'Content-Type: application/json' \
                -H 'X-GitHub-Api-Version: 2022-11-28' \
                https://api.github.com/repos/Rustify-All/rlucene/pulls \
                --data-binary @pr-payload.json \
                -o pr-response.json \
                -w '%{http_code}')
              if [ "$HTTP_STATUS" != '201' ]; then
                cat pr-response.json >&2
                exit 1
              fi
              grep -m1 '"html_url"' pr-response.json || true
            '''
          }
        }
      }
    }
  }

  post {
    always {
      sh(
        returnStatus: true,
        script: '''#!/bin/bash
          if [ -d "$WORKSPACE/java-reference" ]; then
            chmod -R u+rwX "$WORKSPACE/java-reference" \
              >/dev/null 2>&1 || true
          fi
        '''
      )
      archiveArtifacts(
        artifacts: 'source/initial-test.log,source/initial-nextest-junit.xml,source/final-test.log,source/final-nextest-junit.xml,deepseek-result.jsonl,source/pr-response.json',
        allowEmptyArchive: true
      )
    }

    failure {
      emailext(
        to: 'luxugang@apache.org',
        subject: "[Jenkins] ${env.JOB_NAME} #${env.BUILD_NUMBER} failed",
        body: """Autofix build: ${env.BUILD_URL}
Failed commit: ${params.FAILED_SHA}
Upstream build: ${params.UPSTREAM_BUILD_URL}
Upstream failure kind: ${params.UPSTREAM_FAILURE_KIND}
No branch or PR is published unless every verification step succeeds.
""",
        attachLog: true,
        compressLog: true
      )
    }
  }
}
